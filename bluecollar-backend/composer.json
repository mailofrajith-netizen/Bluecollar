{
  "name": "bluecollar/api",
  "description": "Bluecollar E-Commerce PHP REST API",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^6.10",
    "phpmailer/phpmailer": "^6.9",
    "tecnickcom/tcpdf": "^6.7",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "Bluecollar\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "audit": {
      "abandoned": "report",
      "ignore": ["PKSA-y2cr-5h3j-g3ys"]
    }
  }
}
